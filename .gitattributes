# Auto-detect text; force LF in the working tree for text files
* text=auto eol=lf

# Shell scripts must be LF (you already had this — keep it explicit)
*.sh text eol=lf

# Never normalize the committed pnpm store — would break integrity hashes
.pnpm-store/** binary
# A pattern containing a slash is anchored to this file's directory, so the line
# above only covers a root-level store; the vendored one lives under frontend/.
frontend/.pnpm-store/** binary